@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<header class="site-header">
    <div class="nav-shell">
        <a class="brand" href="/" aria-label="David's Cool Components home">
            <img class="brand-mark" src="coding-with-david.png" alt="" width="48" height="48" />
            <span>David's Cool Components</span>
        </a>
        <button @ref="_toggle" class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation"
                aria-haspopup="dialog" aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="OpenMenu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
    </div>
</header>

<dialog @ref="_sidebar" id="site-navigation" class="sidebar" aria-labelledby="sidebar-title"
        @oncancel="CloseMenu" @oncancel:preventDefault @onclick="HandleBackdropClick">
    <div class="sidebar-heading">
        <h2 id="sidebar-title">Coding with David</h2>
        <button class="close-menu" type="button" aria-label="Close navigation" @onclick="CloseMenu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
    </div>
    <nav class="sidebar-nav" aria-label="Main navigation">
        <a href="/" aria-current="@CurrentPage("")" @onclick='() => Navigate("/")' @onclick:preventDefault>Countdown</a>
        <a href="/clock" aria-current="@CurrentPage("clock")" @onclick='() => Navigate("/clock")' @onclick:preventDefault>Digital clock</a>
        <a href="/testimonialslider" aria-current="@CurrentPage("testimonialslider")" @onclick='() => Navigate("/testimonialslider")' @onclick:preventDefault>Testimonials</a>
    </nav>
</dialog>

@code {
    private ElementReference _sidebar, _toggle;
    private IJSObjectReference? _module;
    private bool _menuOpen, _closing;

    private string? CurrentPage(string path) =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/')
            .Equals(path, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    private async Task OpenMenu()
    {
        if (_menuOpen || _closing) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sidebar.js");
        await _module.InvokeVoidAsync("open", _sidebar);
        _menuOpen = true;
    }

    private async Task CloseMenu()
    {
        if (!_menuOpen || _closing || _module is null) return;
        _closing = true;
        try
        {
            await _module.InvokeVoidAsync("close", _sidebar);
            _menuOpen = false;
            await _toggle.FocusAsync();
        }
        finally
        {
            _closing = false;
        }
    }

    private async Task HandleBackdropClick(MouseEventArgs args)
    {
        if (_module is not null && await _module.InvokeAsync<bool>("isOutside", _sidebar, args.ClientX, args.ClientY))
        {
            await CloseMenu();
        }
    }

    private async Task Navigate(string url)
    {
        if (_closing) return;
        await CloseMenu();
        Navigation.NavigateTo(url);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _sidebar);
            await _module.DisposeAsync();
        }
    }
}
