@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="countdown">
    <div class="countdown-sizing">
        <div class="countdown-grid" role="timer" aria-label="@($"{_days} days, {_hours} hours, {_minutes} minutes, {_seconds} seconds remaining")">
            <div class="countdown-unit">
                <button @ref="_daysControl" type="button" class="time-card days" aria-label="Days: set countdown date"
                        title="Right-click to set the countdown date" aria-haspopup="dialog"
                        @oncontextmenu="OpenEditor" @oncontextmenu:preventDefault @onclick="OpenEditor">
                    <span class="digits" style="@DaysFontSize" data-value="@_days.ToString("00")">@_days.ToString("00")</span>
                </button>
                <span class="unit-label">Days</span>
            </div>
            <div class="countdown-unit"><div class="time-card hours"><span class="digits" data-value="@_hours.ToString("00")">@_hours.ToString("00")</span></div><span class="unit-label">Hours</span></div>
            <div class="countdown-unit"><div class="time-card minutes"><span class="digits" data-value="@_minutes.ToString("00")">@_minutes.ToString("00")</span></div><span class="unit-label">Minutes</span></div>
            <div class="countdown-unit"><div class="time-card seconds"><span class="digits" data-value="@_seconds.ToString("00")">@_seconds.ToString("00")</span></div><span class="unit-label">Seconds</span></div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_error) && !_editing)
    {
        <div class="page-error" role="alert">@_error <button type="button" @onclick="OpenEditor">Set date</button></div>
    }
    <span class="visually-hidden" role="status">@(_complete ? "Countdown complete." : string.Empty)</span>

@if (_editing)
{
    <div class="editor-backdrop">
        <section class="date-editor" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onkeydown="HandleEditorKey">
            <h2 id="@_titleId">Set countdown date</h2>
            <p>Choose a future date and time in your local time zone.</p>
            <form @onsubmit="SaveDate" @onsubmit:preventDefault>
                <label for="@_inputId">Target date and time</label>
                <input @ref="_dateInput" id="@_inputId" type="datetime-local" value="@_dateValue" @onchange="DateChanged" required />
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="editor-error" role="alert">@_error</p>
                }
                <div class="editor-actions">
                    <button type="button" class="cancel-button" @onclick="CloseEditor">Cancel</button>
                    <button type="submit" class="save-button">Save date</button>
                </div>
            </form>
        </section>
    </div>
}
</div>

@code {
    [Parameter]
    public string StorageKey { get; set; } = "cool-components.countdown.target";

    [Parameter]
    public DateTimeOffset? InitialTargetDate { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly string _titleId = $"countdown-title-{Guid.NewGuid():N}";
    private readonly string _inputId = $"countdown-date-{Guid.NewGuid():N}";
    private ElementReference _root;
    private string _storageKey = string.Empty;
    private IJSObjectReference? _module;
    private Task _ticker = Task.CompletedTask;
    private ElementReference _daysControl;
    private ElementReference _dateInput;
    private DateTimeOffset _target;
    private string _dateValue = string.Empty;
    private string _savedDateValue = string.Empty;
    private string? _error;
    private int _days, _hours, _minutes, _seconds;
    private bool _editing, _focusEditor, _complete, _disposed;
    private string? DaysFontSize => _days < 1000 ? null
        : FormattableString.Invariant($"font-size: {21.0 / _days.ToString().Length:0.##}cqw");

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(StorageKey))
        {
            throw new ArgumentException("A non-empty storage key is required.", nameof(StorageKey));
        }
        _storageKey = StorageKey;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/countdown.js");
                var settings = await _module.InvokeAsync<CountdownSettings>("load", _storageKey, InitialTargetDate?.ToUnixTimeMilliseconds());
                await _module.InvokeVoidAsync("attach", _root);
                ApplySettings(settings);
                _ticker = TickAsync(_lifetime.Token);
            }
            catch (JSException)
            {
                _error = "The saved countdown could not be loaded. Please set a date; check that browser storage is enabled.";
            }
            StateHasChanged();
        }
        if (_focusEditor)
        {
            _focusEditor = false;
            await _dateInput.FocusAsync();
        }
    }

    private void ApplySettings(CountdownSettings settings)
    {
        _target = DateTimeOffset.FromUnixTimeMilliseconds(settings.TargetMilliseconds);
        _dateValue = settings.LocalValue;
        _savedDateValue = settings.LocalValue;
        UpdateCountdown();
    }

    private void UpdateCountdown()
    {
        var remaining = _target - DateTimeOffset.UtcNow;
        var totalSeconds = Math.Max(0L, (long)Math.Ceiling(remaining.TotalSeconds));
        _days = (int)(totalSeconds / 86400);
        _hours = (int)(totalSeconds / 3600 % 24);
        _minutes = (int)(totalSeconds / 60 % 60);
        _seconds = (int)(totalSeconds % 60);
        _complete = totalSeconds == 0;
    }

    private async Task TickAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    if (!_disposed)
                    {
                        var previous = (_days, _hours, _minutes, _seconds);
                        UpdateCountdown();
                        if (previous != (_days, _hours, _minutes, _seconds))
                        {
                            StateHasChanged();
                        }
                    }
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private void OpenEditor()
    {
        _dateValue = _savedDateValue;
        _editing = true;
        _focusEditor = true;
        _error = null;
    }

    private void DateChanged(ChangeEventArgs args) => _dateValue = args.Value?.ToString() ?? string.Empty;

    private async Task CloseEditor()
    {
        _editing = false;
        _error = null;
        await _daysControl.FocusAsync();
    }

    private async Task SaveDate()
    {
        if (_module is null)
        {
            _error = "The date editor could not initialize. Reload the page and try again.";
            return;
        }
        try
        {
            var settings = await _module.InvokeAsync<CountdownSettings>("save", _storageKey, _dateValue);
            ApplySettings(settings);
            if (_ticker.IsCompleted)
            {
                _ticker = TickAsync(_lifetime.Token);
            }
            await CloseEditor();
        }
        catch (JSException exception)
        {
            _error = exception.Message.Contains("future date", StringComparison.Ordinal)
                ? "Choose a valid future date and time."
                : "Your date could not be saved. Check that browser storage is enabled and try again.";
        }
    }

    private async Task HandleEditorKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseEditor();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _lifetime.CancelAsync();
        await _ticker;
        _lifetime.Dispose();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _root);
            await _module.DisposeAsync();
        }
    }

    private sealed class CountdownSettings
    {
        public long TargetMilliseconds { get; set; }
        public string LocalValue { get; set; } = string.Empty;
    }
}
